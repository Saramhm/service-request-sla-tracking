    {
      "id": "2d3e4f50-0000-4a00-8b00-00000000b004",
      "name": "200 Updated",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        800,
        60
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify(Object.assign({ ok: true }, $json.result)) }}",
