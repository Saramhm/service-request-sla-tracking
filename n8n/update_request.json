        "operation": "executeQuery",
        "query": "SELECT update_request($1::jsonb) AS result;",
        "options": {
          "queryReplacement": "={{ [ { request_id: $json.body?.request_id, status: $json.body?.status, assigned_to: $json.body?.assigned_to, note: $json.body?.note, actor: $json.body?.actor } ] }}"
        }
