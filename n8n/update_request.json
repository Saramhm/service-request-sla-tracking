                    "id": "b1e3f0c2-2222-4a8b-9c0d-000000000001",
                    "leftValue": "={{ $json.result.outcome }}",
                    "rightValue": "UPDATED",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
