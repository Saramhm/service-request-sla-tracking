# Copy to .env and change the secrets before running: docker compose up -d
POSTGRES_USER=servicedesk
POSTGRES_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Timezone n8n uses for schedules (escalation, the 08:00 report) and email dates.
# The SLA calendar itself reads app_settings.business_timezone in the database
# (seeded as Asia/Tehran); keep the two the same. Timestamps are stored in UTC.
BUSINESS_TIMEZONE=Asia/Tehran

# Optional image pins
# N8N_VERSION=latest
# APPSMITH_VERSION=latest
# MAILPIT_VERSION=latest
